# Backend REST API Base URL
# Production (Render): https://samundar-ke-sath-backend.onrender.com/api
# Local web/iOS simulator: http://localhost:5000/api
# Android emulator: http://10.0.2.2:5000/api
# Physical device (Expo Go): http://<YOUR_LAN_IP>:5000/api
EXPO_PUBLIC_API_URL=https://samundar-ke-sath-backend.onrender.com/api

# App Display Metadata
EXPO_PUBLIC_APP_NAME=Samundar Ke Sath

# Google OAuth Client IDs (Public OAuth Client IDs only — never put secrets here!)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=


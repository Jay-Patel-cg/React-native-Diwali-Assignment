        {
          "name": "1. AI Trip Planner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Marked as draft estimates only\", function () {",
                  "    pm.expect(json.data.metadata.estimatesOnly).to.be.true;",
                  "    pm.expect(json.data.metadata.savedToDatabase).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"South Goa, India\",\n  \"origin\": \"Mumbai\",\n  \"startDate\": \"2026-12-10\",\n  \"endDate\": \"2026-12-13\",\n  \"travelers\": 2,\n  \"budget\": 28000,\n  \"currency\": \"INR\",\n  \"travelStyle\": [\"coastal\", \"relaxation\"],\n  \"interests\": [\"beaches\", \"kayaking\", \"local seafood\", \"sunsets\"],\n  \"accommodationPreferences\": \"Boutique beach cottages near Palolem\",\n  \"transportPreferences\": \"Overnight train + rented scooter\"\n}"
